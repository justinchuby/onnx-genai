+//! Cold factory selection for an isolated attribution experiment.
+//! Returned kernels have no probe wrapper or hot-path mode branch.
+use crate::CpuMemoryResources;
+use onnx_runtime_ep_api::{Kernel, KernelFactory, OpKey, OpRegistry, Result, WorkspacePlanning};
+use onnx_runtime_ir::Node;
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+#[derive(Clone, Copy, Debug)]
+pub enum ExpertBankProbeArm {
+    Before,
+    OriginalBanks,
+    Banked,
+}
+
+struct CountedFactory<F> {
+    factory: F,
+    creates: Arc<AtomicUsize>,
+}
+impl<F: KernelFactory> KernelFactory for CountedFactory<F> {
+    fn create(&self, node: &Node, shapes: &[Vec<usize>]) -> Result<Box<dyn Kernel>> {
+        let kernel = self.factory.create(node, shapes)?;
+        self.creates.fetch_add(1, Ordering::Relaxed);
+        Ok(kernel)
+    }
+}
+
+pub(crate) fn configure(
+    registry: &mut OpRegistry,
+    resources: &CpuMemoryResources,
+    arm: ExpertBankProbeArm,
+    creates: Arc<AtomicUsize>,
+) {
+    let weights = resources.weight_memory().clone();
+    let limit = resources.weight_cache_limits().dense_bytes;
+    let (block, float): (Box<dyn KernelFactory>, Box<dyn KernelFactory>) = match arm {
+        ExpertBankProbeArm::Before => (
+            Box::new(CountedFactory {
+                factory: super::probe_before_block_quantized_moe::BlockQuantizedMoEFactory::new(
+                    weights, limit,
+                ),
+                creates: creates.clone(),
+            }),
+            Box::new(CountedFactory {
+                factory: super::probe_before_moe::MoEFactory,
+                creates,
+            }),
+        ),
+        ExpertBankProbeArm::OriginalBanks => (
+            Box::new(CountedFactory {
+                factory:
+                    super::probe_original_banks_block_quantized_moe::BlockQuantizedMoEFactory::new(
+                        weights, limit,
+                    ),
+                creates: creates.clone(),
+            }),
+            Box::new(CountedFactory {
+                factory: super::probe_original_banks_moe::MoEFactory,
+                creates,
+            }),
+        ),
+        ExpertBankProbeArm::Banked => (
+            Box::new(CountedFactory {
+                factory: super::block_quantized_moe::BlockQuantizedMoEFactory::new(weights, limit),
+                creates: creates.clone(),
+            }),
+            Box::new(CountedFactory {
+                factory: super::moe::MoEFactory,
+                creates,
+            }),
+        ),
+    };
+    registry.register(
+        OpKey::new("BlockQuantizedMoE", "pkg.nxrt", 1),
+        WorkspacePlanning::Metadata,
+        block,
+    );
+    registry.register(
+        OpKey::new("MoE", "com.microsoft", 1),
+        WorkspacePlanning::Metadata,
+        float,
+    );
+}
diff --git a/crates/onnx-runtime-ep-cpu/src/kernels/probe_before_block_quantized_moe.rs b/crates/onnx-runtime-ep-cpu/src/kernels/probe_before_block_quantized_moe.rs
