+    #[test]
+    fn contiguous_input_windows_borrow_subranges_and_reject_reordering() {
+        let input: Vec<f32> = (0..12).map(|i| i as f32).collect();
+        for (rows, start, count) in [(vec![0, 1, 2], 0, 6), (vec![1, 2], 2, 4), (vec![3], 6, 2)] {
+            let tasks: Vec<_> = rows.into_iter().map(|row| (row, 1.0)).collect();
+            let window = contiguous_input_window(&input, 2, &tasks).unwrap();
+            assert_eq!(window, &input[start..start + count]);
+            assert_eq!(
+                window.as_ptr(),
+                input[start..].as_ptr(),
+                "must borrow the original input storage"
+            );
+        }
+        for rows in [
+            vec![],
+            vec![0, 2],
+            vec![2, 1],
+            vec![1, 1],
+            vec![6],
+            vec![usize::MAX],
+        ] {
+            let tasks: Vec<_> = rows.into_iter().map(|row| (row, 1.0)).collect();
+            assert!(
+                contiguous_input_window(&input, 2, &tasks).is_none(),
+                "rows={tasks:?}"
+            );
+        }
+    }
