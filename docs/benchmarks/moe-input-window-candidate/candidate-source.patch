+/// Borrow a forward-contiguous group without copying. Check actual ordering:
+/// reordered, repeated or discontiguous rows must retain the gather path.
+fn contiguous_input_window<'a>(
+    input: &'a [f32],
+    width: usize,
+    tasks: &[(usize, f32)],
+) -> Option<&'a [f32]> {
+    let first = tasks.first()?.0;
+    let end = first.checked_add(tasks.len())?;
+    if !tasks
+        .iter()
+        .enumerate()
+        .all(|(offset, &(row, _))| row == first + offset)
+    {
+        return None;
+    }
+    input.get(first.checked_mul(width)?..end.checked_mul(width)?)
+}
