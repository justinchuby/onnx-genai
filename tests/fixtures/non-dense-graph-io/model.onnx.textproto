ir_version: 11
producer_name: "onnx-genai-tests"
producer_version: "0.1.0"
opset_import {
  domain: ""
  version: 24
}
# A deliberately tiny graph whose only purpose is to carry ONE non-dense graph
# output alongside an ordinary dense KV pair.
#
# It exists because these tests previously borrowed
# `tiny-glm52-qmoe-indexshare`, which is a real end-to-end model fixture owned
# by the decode work. When #1832 regenerated that fixture, `logits` became an
# ordinary dense tensor, and the non-dense premise these tests are built on
# silently disappeared -- one test failed, and its sibling kept passing while
# no longer testing anything. A fixture that exists solely to be non-dense
# cannot be regenerated out from under them by unrelated model work.
#
# `logits` is a sequence type, which is a legal ONNX graph output and is
# exactly what `value_info_to_tensor_info` must reject.
graph {
  name: "non_dense_graph_io"
  input {
    name: "past_key_values.0.key"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_param: "batch"
          }
          dim {
            dim_value: 8
          }
          dim {
            dim_param: "past_sequence_length"
          }
          dim {
            dim_value: 128
          }
        }
      }
    }
  }
  input {
    name: "past_key_values.0.value"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_param: "batch"
          }
          dim {
            dim_value: 8
          }
          dim {
            dim_param: "past_sequence_length"
          }
          dim {
            dim_value: 128
          }
        }
      }
    }
  }
  output {
    name: "present.0.key"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_param: "batch"
          }
          dim {
            dim_value: 8
          }
          dim {
            dim_param: "total_sequence_length"
          }
          dim {
            dim_value: 128
          }
        }
      }
    }
  }
  output {
    name: "present.0.value"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_param: "batch"
          }
          dim {
            dim_value: 8
          }
          dim {
            dim_param: "total_sequence_length"
          }
          dim {
            dim_value: 128
          }
        }
      }
    }
  }
  output {
    name: "logits"
    type {
      sequence_type {
        elem_type {
          tensor_type {
            elem_type: 1
          }
        }
      }
    }
  }
}
