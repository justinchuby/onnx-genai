ir_version: 11
opset_import { domain: "" version: 24 }
graph { name: "multimodal_pair_classifier"
node { input: "input_ids" output: "input_ids.float" op_type: "Cast" attribute { name: "to" i: 1 type: INT } }
node { input: "attention_mask" output: "attention_mask.float" op_type: "Cast" attribute { name: "to" i: 1 type: INT } }
node { input: "token_type_ids" output: "token_type_ids.float" op_type: "Cast" attribute { name: "to" i: 1 type: INT } }
node { input: "one" input: "token_type_ids.float" output: "query_type" op_type: "Sub"  }
node { input: "query_type" input: "attention_mask.float" output: "query_mask" op_type: "Mul"  }
node { input: "token_type_ids.float" input: "attention_mask.float" output: "document_mask" op_type: "Mul"  }
node { input: "input_ids.float" input: "query_mask" output: "query_values" op_type: "Mul"  }
node { input: "input_ids.float" input: "document_mask" output: "document_values" op_type: "Mul"  }
node { input: "query_values" input: "sequence_axis" output: "query_sum" op_type: "ReduceSum" attribute { name: "keepdims" i: 0 type: INT } }
node { input: "document_values" input: "sequence_axis" output: "document_sum" op_type: "ReduceSum" attribute { name: "keepdims" i: 0 type: INT } }
node { input: "query_sum" input: "query_bias" output: "query_content" op_type: "Sub"  }
node { input: "query_content" input: "document_sum" output: "difference" op_type: "Sub"  }
node { input: "difference" output: "distance" op_type: "Abs"  }
node { input: "distance" output: "logit" op_type: "Neg"  }
node { input: "query_pixels" input: "primary_pixels" output: "primary.difference" op_type: "Sub" }
node { input: "primary.difference" output: "primary.distance" op_type: "Abs" }
node { input: "primary.distance" input: "image_axes" output: "primary.mean" op_type: "ReduceMean" attribute { name: "keepdims" i: 0 type: INT } }
node { input: "query_pixels" input: "secondary_pixels" output: "secondary.difference" op_type: "Sub" }
node { input: "secondary.difference" output: "secondary.distance" op_type: "Abs" }
node { input: "secondary.distance" input: "image_axes" output: "secondary.mean" op_type: "ReduceMean" attribute { name: "keepdims" i: 0 type: INT } }
node { input: "secondary.mean" input: "secondary_weight" output: "secondary.weighted" op_type: "Mul" }
node { input: "primary.mean" input: "secondary.weighted" output: "image.distance" op_type: "Add" }
node { input: "attention_mask" input: "sequence_axis" output: "prompt_tokens" op_type: "ReduceSum" attribute { name: "keepdims" i: 0 type: INT } }
node { input: "logit" input: "image.distance" output: "joint.logit" op_type: "Sub" }
node { input: "joint.logit" output: "score" op_type: "Sigmoid" }
input { name: "input_ids" type { tensor_type { elem_type: 7 shape { dim { dim_param: "batch" } dim { dim_param: "sequence" } } } } }
input { name: "attention_mask" type { tensor_type { elem_type: 7 shape { dim { dim_param: "batch" } dim { dim_param: "sequence" } } } } }
input { name: "token_type_ids" type { tensor_type { elem_type: 7 shape { dim { dim_param: "batch" } dim { dim_param: "sequence" } } } } }
input { name: "query_pixels" type { tensor_type { elem_type: 1 shape { dim { dim_param: "image_batch" } dim { dim_value: 3 } dim { dim_value: 2 } dim { dim_value: 2 } } } } }
input { name: "primary_pixels" type { tensor_type { elem_type: 1 shape { dim { dim_param: "image_batch" } dim { dim_value: 3 } dim { dim_value: 2 } dim { dim_value: 2 } } } } }
input { name: "secondary_pixels" type { tensor_type { elem_type: 1 shape { dim { dim_param: "image_batch" } dim { dim_value: 3 } dim { dim_value: 2 } dim { dim_value: 2 } } } } }
output { name: "prompt_tokens" type { tensor_type { elem_type: 7 shape { dim { dim_param: "batch" } } } } }
output { name: "score" type { tensor_type { elem_type: 1 shape { dim { dim_param: "batch" } } } } }
initializer { name: "image_axes" data_type: 7 dims: 3 int64_data: 1 int64_data: 2 int64_data: 3 }
initializer { name: "secondary_weight" data_type: 1 dims: 1 float_data: 2 }
initializer { name: "sequence_axis" data_type: 7 dims: 1 int64_data: 1 }
initializer { name: "one" data_type: 1 dims: 1 float_data: 1 }
initializer { name: "query_bias" data_type: 1 dims: 1 float_data: 2 }
}
