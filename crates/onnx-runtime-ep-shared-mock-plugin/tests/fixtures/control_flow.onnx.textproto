ir_version: 11
opset_import { domain: "" version: 24 }
graph {
  name: "runtime_if"
  input { name: "x" type { tensor_type { elem_type: 1 shape { dim { dim_value: 2 } } } } }
  input { name: "condition" type { tensor_type { elem_type: 9 shape {} } } }
  output { name: "output" type { tensor_type { elem_type: 1 shape { dim { dim_param: "n" } } } } }
  node {
    name: "select" op_type: "If" input: "condition" output: "selected"
    attribute {
      name: "then_branch" type: GRAPH g {
        name: "then"
        node { op_type: "Identity" input: "x" output: "then_output" }
        output { name: "then_output" type { tensor_type { elem_type: 1 shape { dim { dim_value: 2 } } } } }
      }
    }
    attribute {
      name: "else_branch" type: GRAPH g {
        name: "else"
        node { op_type: "Concat" input: "x" input: "x" output: "else_output" attribute { name: "axis" type: INT i: -1 } }
        output { name: "else_output" type { tensor_type { elem_type: 1 shape { dim { dim_value: 4 } } } } }
      }
    }
  }
  node { name: "after" op_type: "Identity" input: "selected" output: "output" }
}
