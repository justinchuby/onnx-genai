      tensor_type {
        elem_type: 1
        shape { dim { dim_value: 1 } dim { dim_value: 4 } dim { dim_value: 1 } }
      }
    }
  }
  value_info {
    name: "spectrum"
    type {
      tensor_type {
        elem_type: 1
        shape { dim { dim_value: 1 } dim { dim_value: 3 } dim { dim_value: 2 } }
      }
    }
  }
  output {
    name: "Y"
    type {
      tensor_type {
        elem_type: 1
        shape { dim { dim_value: 1 } dim { dim_value: 4 } dim { dim_value: 1 } }
      }
    }
  }
}
