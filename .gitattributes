# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
.squad/rai/audit-trail.md merge=union
.squad/fact-checker/audit-trail.md merge=union

# schema_sync compares this generated file byte-for-byte; force LF so the check
# passes on Windows checkouts (autocrlf would otherwise convert it to CRLF).
schema/inference_metadata.schema.json text eol=lf

# The Qwen4 reference generator and fixture are compared byte-for-byte. Keep
# both canonical on checkout so Git for Windows cannot make the artifact stale.
crates/onnx-genai-engine/tests/fixtures/generate_qwen4_exp_ple_reference.py text eol=lf
crates/onnx-genai-engine/tests/fixtures/qwen4_exp_ple_reference.json text eol=lf

# Catalogue metadata examples are embedded with include_str! and matched line by
# line in tests (e.g. crates/onnx-genai-metadata/tests/gemma4_e2b_workflow.rs
# mutates specific `\n`-terminated lines). Force LF so autocrlf does not turn a
# Windows checkout into CRLF and silently break those exact string matches.
examples/inference_metadata/catalogue/*.yaml text eol=lf

# The root-file allowlist is compared byte-for-byte against `git ls-files`, so a
# CRLF checkout would put a stray \r on every entry and mismatch all of them at
# once. The check strips CR defensively; this keeps it from arising.
.github/root-file-allowlist.txt text eol=lf

# Shell scripts and the extension-less git hooks are executed by bash. With
# core.autocrlf=true (the Git-for-Windows default) they check out as CRLF, and
# bash then chokes on the stray carriage returns ("$'\r': command not found",
# "set: pipefail: invalid option name") — the script cannot run at all. Pin
# them to LF so they stay executable on Windows working trees.
*.sh text eol=lf
scripts/hooks/* text eol=lf

# Serialized ONNX protobufs must remain byte-identical across checkouts.
*.onnx binary
